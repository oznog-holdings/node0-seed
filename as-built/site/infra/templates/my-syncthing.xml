  <Config Name="PGID" Target="PGID" Default="" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">100</Config>
  <Config Name="STGUIADDRESS" Target="STGUIADDRESS" Default="" Mode="" Description="GUI inside the container; published on 127.0.0.1 only" Type="Variable" Display="always" Required="true" Mask="false">0.0.0.0:8384</Config>
