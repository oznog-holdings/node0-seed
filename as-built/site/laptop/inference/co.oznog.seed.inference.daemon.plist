<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The inference supervisor AS seed (never root), from boot, without seed logging in. Nice 5: the
     person's processes win the CPU. ProcessType Standard: Background would confine it to E-cores. -->
<dict>
  <key>Label</key><string>co.oznog.seed.inference</string>
  <key>UserName</key><string>seed</string>
  <key>GroupName</key><string>staff</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Users/seed/.local/share/seed/laptop/inference/supervise.sh</string></array>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>/Users/seed</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>/Users/seed/.local/state/seed/inference/supervise.log</string>
  <key>StandardErrorPath</key><string>/Users/seed/.local/state/seed/inference/supervise.log</string>
</dict>
</plist>
