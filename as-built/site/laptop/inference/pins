# The memory ceiling (README). 20260927: 48 GiB on the dedicated Mac (was 16 GiB beside a person's work)
CTX=65536                           # two slots of 32k tokens (dedicated Mac, 48 GiB ceiling)
PARALLEL=2
CACHE_RAM_MIB=0                     # the server's prompt cache in RAM (default 8192 MiB) off
SLEEP_IDLE_S=-1                     # no idle unload on the dedicated Mac (was 900 s beside a person)
CEILING_MIB=49152                   # supervise.sh holds the server if its resident size passes this. 48 GiB; 52 GiB for the RAM prompt cache of 20260930, reverted the same day (the cache used memory this figure cannot see)
YIELD_FREE=5                        # supervise.sh: stop the server below this system-wide free %, or off "normal" pressure. 20 until
                                    # 20260928: at the 48 GiB ceiling free is about 10% by arithmetic (64 - 48 - macOS 9.4), so 20 yielded
                                    # before the ceiling (rung 4b: a test of 8 GB more gave 19% and a yield, pressure normal). 5 is a backstop;
                                    # the pressure level is the signal
RESUME_FREE=60                      # ... and start it again at this free % (the model unloaded: about 95% measured)
CALM_S=900                          # ... after this many calm seconds
LISTEN=192.168.1.20
PORT=8080
MODELS_MAX=8                        # the router: at most this many loaded (the utility tier, 20261002: every model in presets.ini may be;
                                    # memory, not this count, is what limits, and the supervisor holds it: ON_DEMAND below)
ON_DEMAND="local-chat local-text"   # unloaded first, in this order, when the tree nears the ceiling or pressure rises (supervise.sh)
